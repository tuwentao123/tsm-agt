# Copy this file to .env. Never commit the real API key.
# TSM_AGT_MODEL selects the protocol and active model: open or anthropic.
TSM_AGT_MODEL=open
# Both protocol modes use this endpoint; their Providers use different POST paths.
TSM_AGT_MODEL_BASE_URL=http://127.0.0.1:5580
TSM_AGT_OPEN_MODEL=your-open-model-name
# Used when TSM_AGT_MODEL=anthropic.
# TSM_AGT_ANTHROPIC_MODEL=your-anthropic-model-name
TSM_AGT_MODEL_API_KEY=your-api-key
TSM_AGT_MODEL_TIMEOUT_SECONDS=180
TSM_AGT_MODEL_MAX_RETRIES=2
TSM_AGT_MODEL_RETRY_BACKOFF_SECONDS=1
# Used by open mode only. Set max_completion_tokens for GPT-5-class endpoints.
TSM_AGT_MODEL_OUTPUT_TOKEN_PARAMETER=max_tokens
# Used by anthropic mode only.
# TSM_AGT_ANTHROPIC_VERSION=2023-06-01
# Set false only when a compatible gateway rejects function.strict=true.
TSM_AGT_MODEL_STRICT_TOOL_SCHEMA=true
TSM_AGT_CONTEXT_COMPACTION_RATIO=0.80
TSM_AGT_CONTEXT_LATENCY_SOFT_TOKENS=0

# How much Session history one Turn renders. Two independent caps, and both bind:
# the projector's count bound applies always, then compaction's floor applies once
# estimated input passes the ratio above. Raise both, and give the Provider a
# window big enough to hold the result, or early turns stay out of the prompt.
# Counts messages, so a user/assistant round trip costs two.
# Optional: path to the ripgrep binary the workspace search tools locate
# with. Resolution is this override first, then PATH -- no install directory
# is guessed, so a service with a minimal PATH sets it here. Absent is
# normal: the slower in-tree walker answers instead.
# TSM_AGT_RIPGREP=/opt/homebrew/bin/rg
TSM_AGT_SESSION_RECENT_MESSAGES=8
TSM_AGT_SESSION_TASK_SUMMARIES=4
TSM_AGT_CONTEXT_RECENT_MESSAGE_FLOOR=8

# Optional commercial search provider (default off: queries stay on keyless
# public endpoints only). 'keyless' uses Tavily's free keyless mode and
# forwards web.search queries to Tavily; 'key' additionally requires the key.
# TSM_AGT_SEARCH_TAVILY_MODE=off
# TSM_AGT_SEARCH_TAVILY_API_KEY=tvly-...

# Bounded, process-local documents retained for web.open → web.find_in_page.
# Entries are isolated by Task + turn and are cleared when the Tool provider stops.
# TSM_AGT_WEB_DOCUMENT_CACHE_MAX_ENTRIES=32
# TSM_AGT_WEB_DOCUMENT_CACHE_MAX_BYTES=1000000
# TSM_AGT_WEB_REFERENCE_CACHE_MAX_ENTRIES=128
# TSM_AGT_WEB_DOCUMENT_CACHE_TTL_SECONDS=600

# Optional bounded GitHub source research. Public repositories use R0. Setting
# private access requires an explicit API host + exact repo allowlist and every
# request is R1 approval-gated. The token is host configuration only: never put
# it in a tool call or model prompt.
# TSM_AGT_GITHUB_SOURCE_ENABLED=false
# TSM_AGT_GITHUB_API_BASE=https://api.github.com
# TSM_AGT_GITHUB_ALLOWED_HOSTS=api.github.com
# TSM_AGT_GITHUB_PRIVATE_ACCESS=false
# TSM_AGT_GITHUB_ALLOWED_REPOSITORIES=owner/repository
# TSM_AGT_GITHUB_TOKEN=github_pat_...
# TSM_AGT_GITHUB_CACHE_TTL_SECONDS=300
# TSM_AGT_GITHUB_CACHE_MAX_ENTRIES=128
# TSM_AGT_GITHUB_RESPONSE_MAX_BYTES=512000

# Optional exploration soft limits. Environment variables override this file.
# balanced uses evidence-guided exploration; legacy keeps the old directory policy.
# TSM_AGT_EXPLORATION_PROFILE=balanced
# TSM_AGT_AGENT_MAX_MODEL_CALLS=15
# TSM_AGT_AGENT_MAX_TOOL_CALLS=40
# TSM_AGT_AGENT_FINALIZATION_MODEL_CALLS=2
# TSM_AGT_EXPLORATION_MAX_TOOL_CALLS=24
# TSM_AGT_EXPLORATION_MAX_ACTIONS=24
# TSM_AGT_EXPLORATION_MAX_TOOL_SECONDS=120
# TSM_AGT_EXPLORATION_LOW_VALUE_STREAK=2
# TSM_AGT_EXPLORATION_RESERVE_TOOL_CALLS=2
# TSM_AGT_EXPLORATION_MIN_ACTIONS=2

# Optional semantic review. ``required`` enables it only for Tasks with an
# explicit evidence/delivery contract; ordinary turns rely on the primary Agent
# prompt and deterministic Runtime gate.
# TSM_AGT_COMPLETION_REVIEW_MODE=off
# TSM_AGT_COMPLETION_REVIEW_MAX_CONTINUATIONS=1
# TSM_AGT_COMPLETION_REVIEW_FAILURE_POLICY=visible_unverified
