# Copy this file to .env. Never commit the real API key.
TSM_AGT_MODEL_BASE_URL=http://127.0.0.1:5580
TSM_AGT_MODEL=your-model-name
TSM_AGT_MODEL_API_KEY=your-api-key
TSM_AGT_MODEL_TIMEOUT_SECONDS=180
TSM_AGT_MODEL_MAX_RETRIES=2
TSM_AGT_MODEL_RETRY_BACKOFF_SECONDS=1
# Use max_completion_tokens for GPT-5-class Chat endpoints that reject max_tokens.
TSM_AGT_MODEL_OUTPUT_TOKEN_PARAMETER=max_tokens
# Set false only when a compatible gateway rejects function.strict=true.
TSM_AGT_MODEL_STRICT_TOOL_SCHEMA=true
TSM_AGT_CONTEXT_COMPACTION_RATIO=0.80
TSM_AGT_CONTEXT_LATENCY_SOFT_TOKENS=0

# Optional commercial search provider (default off: queries stay on keyless
# public endpoints only). 'keyless' uses Tavily's free keyless mode and
# forwards web.search queries to Tavily; 'key' additionally requires the key.
# TSM_AGT_SEARCH_TAVILY_MODE=off
# TSM_AGT_SEARCH_TAVILY_API_KEY=tvly-...

# Optional exploration soft limits. Environment variables override this file.
# balanced uses evidence-guided exploration; legacy keeps the old directory policy.
# TSM_AGT_EXPLORATION_PROFILE=balanced
# TSM_AGT_AGENT_MAX_MODEL_CALLS=15
# TSM_AGT_AGENT_MAX_TOOL_CALLS=40
# TSM_AGT_AGENT_FINALIZATION_MODEL_CALLS=2
# TSM_AGT_EXPLORATION_MAX_TOOL_CALLS=24
# TSM_AGT_EXPLORATION_MAX_ACTIONS=24
# TSM_AGT_EXPLORATION_MAX_TOOL_SECONDS=120
# TSM_AGT_EXPLORATION_LOW_VALUE_STREAK=2
# TSM_AGT_EXPLORATION_RESERVE_TOOL_CALLS=2
# TSM_AGT_EXPLORATION_MIN_ACTIONS=2
