          "call_id": "call_RCtBnMc195PGY0GRnzsUeqCd",
          "name": "core.apply_patch",
          "arguments": {
            "path": "labels.py",
            "expected_hash": "03baadfc249fad126d0017ca92df98a79632ab384f61ba6f21322c7f45f6c44a",
            "edits": [
              {
                "old_text": "def normalize(value):\n    return value\n",
                "new_text": "def normalize(value):\n    \"\"\"Normalize a label by trimming outer whitespace and lowercasing.\n\n    Leading and trailing whitespace is removed, internal spaces are\n    preserved, and the remaining characters are converted to lowercase.\n    \"\"\"\n    if value is None:\n        return \"\"\n    return value.strip().lower()\n"
              }
            ]
          }
        },
        {
          "call_id": "call_bWVu9fsCjifeOXVBkJ2Xp6xn",
          "name": "core.apply_patch",
          "arguments": {
